# Variáveis de ambiente do WAVE GLOBAL (configure em Vercel > Settings > Environment Variables)
# Nenhuma é obrigatória: sem elas o site funciona, sem anúncios e sem assistente de IA.

# Endereço público do site (padrão: https://dioglobal-phi.vercel.app). Não altera DNS nem deploy.
SITE_URL=

# Google AdSense (valores da sua conta; nunca invente IDs)
GOOGLE_ADSENSE_CLIENT=ca-pub-0000000000000000
GOOGLE_ADSENSE_SLOT=0000000000
# Opcional: um bloco diferente por posição (só dígitos)
GOOGLE_ADSENSE_SLOT_HEADER=
GOOGLE_ADSENSE_SLOT_BETWEEN=
GOOGLE_ADSENSE_SLOT_SIDE=
GOOGLE_ADSENSE_SLOT_CONTENT=
GOOGLE_ADSENSE_SLOT_FOOTER=

# E-mail exibido na página Sobre
CONTACT_EMAIL=

# Assistente de descoberta (só no servidor; nunca vai para o navegador)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
